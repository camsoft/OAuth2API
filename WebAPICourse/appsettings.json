{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // This API authenticates only via "Authorization: Bearer <jwt>" (no cookies), so it
  // isn't vulnerable to CSRF. Disable .NET 11's automatic CSRF middleware globally -
  // it only recognizes CORS trust via a *default* policy/[EnableCors], which this
  // project doesn't use, causing false "antiforgery validation failed" 500s otherwise.
  "DisableCsrfProtection": true,
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=WebAPICoursePart4Db;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "WebApiCoursePart4",
    "Audience": "WebApiCoursePart4Clients",
    "Key": "dev-only-signing-key-do-not-use-in-production-change-me-1234567890",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  }
}
