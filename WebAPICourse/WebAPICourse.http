@WebAPICourse_HostAddress = http://localhost:5201

GET {{WebAPICourse_HostAddress}}/openapi/v1.json
Accept: application/json

###

GET {{WebAPICourse_HostAddress}}/products/
Accept: application/json

###

# ---------------------------------------------------------------------------
# OAuth 2.0 Authorization Code + PKCE flow (replaces the old /api/auth/login).
# Because this grant is interactive (it requires a browser redirect + login
# form), it can't be fully automated from a single .http request. Steps:
#
# 1. Generate a PKCE code_verifier/code_challenge pair (e.g. via an online
#    PKCE generator, or `openssl rand` + SHA256, base64url-encoded).
# 2. Open this URL in a browser (adjust host/port as needed):
#    {{WebAPICourse_HostAddress}}/connect/authorize
#      ?client_id=webapicourse-spa
#      &response_type=code
#      &redirect_uri=http://localhost:5173/callback
#      &scope=openid profile roles offline_access
#      &code_challenge=YOUR_CODE_CHALLENGE
#      &code_challenge_method=S256
#      &state=some-random-state-value
# 3. Sign in with a seeded user (admin / Admin123! or member / Member123!).
# 4. The browser is redirected to redirect_uri with a `code` query parameter -
#    copy it into @authorizationCode below.
# ---------------------------------------------------------------------------

@authorizationCode = PASTE_CODE_FROM_REDIRECT_HERE
@codeVerifier = PASTE_YOUR_CODE_VERIFIER_HERE

# Exchanges the authorization code for an access token + refresh token.
POST {{WebAPICourse_HostAddress}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&code={{authorizationCode}}&redirect_uri=http://localhost:5173/callback&client_id=webapicourse-spa&code_verifier={{codeVerifier}}

###

@refreshToken = PASTE_REFRESH_TOKEN_FROM_TOKEN_RESPONSE_HERE

# Uses the refresh token to silently obtain a new access token, without
# forcing the user through the login form again.
POST {{WebAPICourse_HostAddress}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&refresh_token={{refreshToken}}&client_id=webapicourse-spa

###

# Revokes a specific access or refresh token (e.g. on manual "log out").
POST {{WebAPICourse_HostAddress}}/connect/revoke
Content-Type: application/x-www-form-urlencoded

token={{refreshToken}}&client_id=webapicourse-spa

###

@token = PASTE_ACCESS_TOKEN_FROM_TOKEN_RESPONSE_HERE

# Writing a Product requires a valid Bearer token (any authenticated user).
POST {{WebAPICourse_HostAddress}}/products/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Wireless Headset",
  "description": "Over-ear wireless headset with noise cancellation",
  "price": 59.99,
  "stockQuantity": 100,
  "categoryId": 2
}

###

# Deleting a Product requires the Admin role - using a Member token here
# will return 403 Forbidden.
DELETE {{WebAPICourse_HostAddress}}/products/1
Authorization: Bearer {{token}}

###

